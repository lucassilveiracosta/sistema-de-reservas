// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  USER
  ADMIN
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  cpf               String?  @unique
  password          String   // Deve armazenar o hash da senha
  role              Role     @default(USER)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reservations      Reservation[]
  favoriteRooms     FavoriteRoom[]

  @@map("users")
}

model Room {
  id          String   @id @default(uuid())
  name        String
  description String?
  capacity    Int
  isActive    Boolean  @default(true) // Permite inativar a sala ao invés de excluí-la
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations  Reservation[]
  favoritedBy   FavoriteRoom[]

  @@map("rooms")
}



model Reservation {
  id        String            @id @default(uuid())
  title     String // Motivo ou título da reserva
  startTime DateTime
  endTime   DateTime
  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  // Índice composto para otimizar as consultas de validação de conflitos de horários na mesma sala
  @@index([roomId, startTime, endTime])
  @@map("reservations")
}

// Tabela aux para gerenciar a lista de salas favoritas dos usuários
model FavoriteRoom {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@map("favorite_rooms")
}
